uniform shader frameTexture;
uniform float2 outputSize;
uniform float2 destinationOrigin;
uniform float2 destinationSize;
uniform float time;

const float2 sourceSize = float2(256.0, 240.0);
const float crtGamma = 2.5;
const float displayGamma = 2.2;

float3 sampleLinear(float2 coordinate) {
    float2 sourcePoint = clamp(coordinate, float2(0.0), float2(1.0)) * sourceSize;
    return pow(max(frameTexture.eval(sourcePoint).rgb, float3(0.0)), float3(crtGamma));
}

float3 horizontalBeam(float2 coordinate) {
    float2 pixel = 1.0 / sourceSize;
    float3 farLeft = sampleLinear(coordinate - float2(1.50 * pixel.x, 0.0));
    float3 left = sampleLinear(coordinate - float2(0.65 * pixel.x, 0.0));
    float3 center = sampleLinear(coordinate);
    float3 right = sampleLinear(coordinate + float2(0.65 * pixel.x, 0.0));
    float3 farRight = sampleLinear(coordinate + float2(1.50 * pixel.x, 0.0));

    // Slightly different channel kernels reproduce analog bandwidth and convergence.
    return float3(
        farLeft.r * 0.08 + left.r * 0.25 + center.r * 0.44 + right.r * 0.19 + farRight.r * 0.04,
        farLeft.g * 0.04 + left.g * 0.21 + center.g * 0.50 + right.g * 0.21 + farRight.g * 0.04,
        farLeft.b * 0.04 + left.b * 0.19 + center.b * 0.44 + right.b * 0.25 + farRight.b * 0.08
    );
}

float3 beamWeight(float3 color, float distanceFromLine) {
    float3 intensity = pow(clamp(color, float3(0.0), float3(1.0)), float3(0.333333));
    float3 sigma = mix(float3(0.08), float3(0.34), intensity);
    float3 shape = mix(float3(2.0), float3(4.0), pow(intensity, float3(0.25)));
    return exp(-pow(float3(abs(distanceFromLine)) / sigma, shape));
}

float3 scanlineBeam(float2 coordinate) {
    float sourceY = coordinate.y * sourceSize.y;
    float lineY = floor(sourceY) + 0.5;
    float distanceFromLine = sourceY - lineY;
    float2 pixel = 1.0 / sourceSize;

    float2 centerCoordinate = float2(coordinate.x, lineY * pixel.y);
    float3 above = horizontalBeam(centerCoordinate - float2(0.0, pixel.y));
    float3 center = horizontalBeam(centerCoordinate);
    float3 below = horizontalBeam(centerCoordinate + float2(0.0, pixel.y));

    float3 color = above * beamWeight(above, distanceFromLine + 1.0);
    color += center * beamWeight(center, distanceFromLine);
    color += below * beamWeight(below, distanceFromLine - 1.0);
    return color * 0.92;
}

float3 bloomApproximation(float2 coordinate) {
    float2 pixel = 1.0 / sourceSize;
    float3 bloom = sampleLinear(coordinate) * 0.20;
    bloom += sampleLinear(coordinate + float2(pixel.x, 0.0)) * 0.11;
    bloom += sampleLinear(coordinate - float2(pixel.x, 0.0)) * 0.11;
    bloom += sampleLinear(coordinate + float2(0.0, pixel.y)) * 0.11;
    bloom += sampleLinear(coordinate - float2(0.0, pixel.y)) * 0.11;
    bloom += sampleLinear(coordinate + pixel) * 0.06;
    bloom += sampleLinear(coordinate - pixel) * 0.06;
    bloom += sampleLinear(coordinate + float2(pixel.x, -pixel.y)) * 0.06;
    bloom += sampleLinear(coordinate + float2(-pixel.x, pixel.y)) * 0.06;
    bloom += sampleLinear(coordinate + float2(2.0 * pixel.x, 0.0)) * 0.03;
    bloom += sampleLinear(coordinate - float2(2.0 * pixel.x, 0.0)) * 0.03;
    bloom += sampleLinear(coordinate + float2(0.0, 2.0 * pixel.y)) * 0.03;
    bloom += sampleLinear(coordinate - float2(0.0, 2.0 * pixel.y)) * 0.03;
    return bloom;
}

float3 slotMask(float2 fragmentPoint) {
    float column = mod(floor(fragmentPoint.x), 3.0);
    float row = mod(floor(fragmentPoint.y / 3.0), 2.0);
    float3 mask = float3(0.55);
    if (column < 1.0) {
        mask.r = 1.90;
    } else if (column < 2.0) {
        mask.g = 1.90;
    } else {
        mask.b = 1.90;
    }

    float slot = mix(0.88, 1.0, step(0.5, mod(fragmentPoint.y, 3.0)));
    return mask * slot * mix(0.96, 1.0, row);
}

float2 curvedCoordinate(float2 coordinate) {
    float2 centered = coordinate * 2.0 - 1.0;
    float2 bend = float2(centered.y * centered.y, centered.x * centered.x);
    return centered * (1.0 + bend * float2(0.035, 0.045)) * 0.5 + 0.5;
}

float borderWeight(float2 coordinate) {
    float2 centered = abs(coordinate * 2.0 - 1.0);
    float2 rounded = centered - float2(0.965, 0.955);
    float distance = length(max(rounded, float2(0.0))) + min(max(rounded.x, rounded.y), 0.0);
    return 1.0 - smoothstep(-0.012, 0.012, distance);
}

float4 main(float2 devicePoint) {
    float2 flatCoordinate = (devicePoint - destinationOrigin) / destinationSize;
    float2 coordinate = curvedCoordinate(flatCoordinate);
    float border = 0.025 + 0.975 * borderWeight(coordinate);
    coordinate = clamp(coordinate, float2(0.0), float2(1.0));

    float3 color = scanlineBeam(coordinate);
    float3 bloom = bloomApproximation(coordinate);
    float bloomLevel = dot(bloom, float3(0.2126, 0.7152, 0.0722));
    float3 brightPass = max(bloom - float3(0.80 * bloomLevel), float3(0.0));

    // CRT Royale-style diffusion and energy-dependent phosphor bloom.
    color = mix(color, bloom, 0.075);
    color += brightPass * (0.10 + 0.16 * smoothstep(0.35, 0.95, bloomLevel));

    float2 fragmentPoint = (coordinate * destinationSize) + destinationOrigin;
    float maskStrength = 0.78 * smoothstep(480.0, 900.0, destinationSize.x);
    color *= mix(float3(1.0), slotMask(fragmentPoint), maskStrength);

    float vignette = 16.0 * coordinate.x * coordinate.y * (1.0 - coordinate.x) * (1.0 - coordinate.y);
    color *= mix(0.72, 1.0, pow(max(vignette, 0.0), 0.22));
    color *= border;

    float noise = fract(sin(dot(devicePoint + float2(time * 17.0, time * 29.0), float2(12.9898, 78.233))) * 43758.5453) - 0.5;
    color *= 1.0 + noise * 0.006;
    color = pow(clamp(color, float3(0.0), float3(1.0)), float3(1.0 / displayGamma));
    return float4(color, 1.0);
}
