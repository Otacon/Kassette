uniform shader frameTexture;
uniform float2 outputSize;
uniform float2 destinationOrigin;
uniform float2 destinationSize;
uniform float time;

const float2 sourceSize = float2(256.0, 240.0);

float randomValue(float2 point) {
    return fract(sin(dot(point, float2(12.9898, 78.233))) * 43758.5453);
}

float3 linearSample(float2 coordinate) {
    float2 sourcePoint = coordinate * sourceSize;
    return pow(frameTexture.eval(sourcePoint).rgb, float3(2.2));
}

float3 analogSignal(float2 coordinate) {
    float2 pixel = 1.0 / sourceSize;
    float3 farLeft = linearSample(coordinate - float2(1.65 * pixel.x, 0.0));
    float3 left = linearSample(coordinate - float2(0.70 * pixel.x, 0.0));
    float3 center = linearSample(coordinate);
    float3 right = linearSample(coordinate + float2(0.70 * pixel.x, 0.0));
    float3 farRight = linearSample(coordinate + float2(1.65 * pixel.x, 0.0));

    float3 signal = float3(0.0);
    signal.r = farLeft.r * 0.07 + left.r * 0.24 + center.r * 0.45 + right.r * 0.20 + farRight.r * 0.04;
    signal.g = farLeft.g * 0.04 + left.g * 0.20 + center.g * 0.52 + right.g * 0.20 + farRight.g * 0.04;
    signal.b = farLeft.b * 0.04 + left.b * 0.20 + center.b * 0.45 + right.b * 0.24 + farRight.b * 0.07;
    return signal;
}

float3 phosphorMask(float2 fragCoord) {
    float row = mod(floor(fragCoord.y / 2.0), 2.0);
    float column = mod(floor(fragCoord.x / 2.0) + row, 3.0);
    float3 mask = float3(0.78);
    if (column < 1.0) {
        mask.r = 1.14;
    } else if (column < 2.0) {
        mask.g = 1.14;
    } else {
        mask.b = 1.14;
    }
    return mask * mix(1.0, 0.94, row);
}

float4 main(float2 devicePoint) {
    float2 textureCoordinate = (devicePoint - destinationOrigin) / destinationSize;
    float2 fragCoord = float2(devicePoint.x, outputSize.y - devicePoint.y);
    float2 sampleCoordinate = textureCoordinate;
    float2 glassPoint = sampleCoordinate * 2.0 - 1.0;

    float3 color = analogSignal(sampleCoordinate);
    float luminance = dot(color, float3(0.2126, 0.7152, 0.0722));

    float linePosition = abs(fract(sampleCoordinate.y * sourceSize.y) - 0.5) * 2.0;
    float beamWidth = mix(0.34, 0.72, smoothstep(0.04, 0.82, luminance));
    float beam = exp(-(linePosition * linePosition) / (2.0 * beamWidth * beamWidth));
    color *= 0.54 + 0.59 * beam;

    float2 bloomPixel = 1.0 / sourceSize;
    float3 bloom = linearSample(sampleCoordinate + float2(0.0, bloomPixel.y)) +
        linearSample(sampleCoordinate - float2(0.0, bloomPixel.y)) +
        linearSample(sampleCoordinate + float2(2.0 * bloomPixel.x, 0.0)) +
        linearSample(sampleCoordinate - float2(2.0 * bloomPixel.x, 0.0));
    bloom *= 0.25;
    color += max(bloom - float3(0.24), float3(0.0)) * 0.075;

    float maskStrength = smoothstep(640.0, 1050.0, outputSize.x);
    color *= mix(float3(1.0), phosphorMask(fragCoord), 0.72 * maskStrength);

    float vignette = 16.0 * sampleCoordinate.x * sampleCoordinate.y *
        (1.0 - sampleCoordinate.x) * (1.0 - sampleCoordinate.y);
    vignette = pow(max(vignette, 0.0), 0.17);
    color *= 0.68 + 0.32 * vignette;

    float noise = randomValue(fragCoord + float2(time * 31.0, time * 17.0)) - 0.5;
    color *= 0.995 + noise * 0.018;
    color *= float3(1.035, 1.0, 0.945);
    color = float3(1.0) - exp(-color * 1.30);
    color = pow(max(color, float3(0.0)), float3(1.0 / 2.2));

    float reflection = pow(max(0.0, 1.0 - length(glassPoint - float2(-0.72, 0.78)) / 1.30), 4.0);
    color += float3(0.055, 0.070, 0.080) * reflection;
    color += float3(0.004, 0.006, 0.009);

    return float4(color, 1.0);
}
